# Operator Pluggability Switches (Strategy Pattern)
# Options: 'postgres' | 'sqlite' | 'memory'
STORAGE_BACKEND=sqlite

# Options: 'kafka' | 'memory'
STREAM_BACKEND=memory

# Options: 'groq' | 'mock'
LLM_PROVIDER=groq

# Options: 'heuristic' | 'xgboost' | 'onnx'
MODEL_SCORER=onnx

# Low-Latency Feature Store (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Observability
LOG_LEVEL=INFO

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Kafka / Redpanda Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_detection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection-experiments

# API Service
API_HOST=0.0.0.0
API_PORT=8000
FRAUD_THRESHOLD=0.5
